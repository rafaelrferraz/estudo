".note-toolbar button { background: transparent; border: 1px solid transparent; color: var(--txt); width: 30px; height: 30px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; }",
".note-toolbar button:hover { background: var(--borda); border-color: var(--borda); }",
".note-editor { width: 100%; height: 200px; background: var(--bg); color: var(--txt); border: none; padding: 20px; font-family: inherit; font-size: 15px; resize: vertical; outline: none; line-height: 1.6; overflow-y: auto; }",
".note-editor img { max-width: 100%; height: auto; border-radius: 6px; margin: 10px 0; border: 1px solid var(--borda); }",
".note-modal-footer { padding: 15px 20px; border-top: 1px solid var(--borda); display: flex; justify-content: flex-end; gap: 10px; }",
"@media print{ header, .sidebar{display:none !important;} body{background:#fff;color:#000;} .q,.g{border-color:#ccc;break-inside:avoid;} .g-footer, .g-edit, .tag b{display:none !important;} }",
"</style>",
"</head>",
"<body>",
"<div id=\"ep-menu-interativo\"></div>",
"",
"<div class=\"note-modal-overlay\" id=\"note-modal\">",
"    <div class=\"note-modal-box\">",
"        <div class=\"note-modal-header\">",
"            <span>📝 Editar Anotação</span>",
"            <button onclick=\"fecharNoteModal()\" style=\"background:none;border:none;color:var(--mut);cursor:pointer;font-size:20px;\">&times;</button>",
"        </div>",
"        <div class=\"note-toolbar\">",
"            <button title=\"Negrito\" onclick=\"formatNote('bold')\"><b>B</b></button>",
"            <button title=\"Itálico\" onclick=\"formatNote('italic')\"><i>I</i></button>",
"            <button title=\"Sublinhado\" onclick=\"formatNote('underline')\"><u>U</u></button>",
"            <button title=\"Destaque\" onclick=\"toggleHighlight()\" style=\"background:#fef08a;color:#1a202c;\">🖊️</button>",
"            <button title=\"Lista\" onclick=\"formatNote('insertUnorderedList')\">•</button>",
"            <button title=\"Limpar Formatação\" onclick=\"formatNote('removeFormat')\">🧹</button>",
"        </div>",
