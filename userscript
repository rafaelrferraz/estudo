    function obterSpansDoGrifo(spanEl) {
        const id = spanEl.getAttribute('data-grifo-id');
        if (!id) return [spanEl];
        return Array.from(document.querySelectorAll(`.estudo-pro-grifo[data-grifo-id="${escaparAttr(id)}"]`));
    }

    function mostrarMenuGerenciarGrifo(rect, spanEl) {
        const spansGrifo = obterSpansDoGrifo(spanEl);
        const idGrifo = spanEl.getAttribute('data-grifo-id');
        const url = spanEl.getAttribute('data-url');
        const corAtual = spanEl.style.backgroundColor || '#fef08a';

        function paraHex(c) {
            if (!c) return '#fef08a';
            if (c.startsWith('#')) return c;
            const m = c.match(/\d+/g);
            if (!m) return '#fef08a';
            return '#' + m.slice(0, 3).map(x => (+x).toString(16).padStart(2, '0')).join('');
        }
        const corHexAtual = paraHex(corAtual);

        const paleta = [
            { hex: '#fef08a', titulo: 'Amarelo' },
            { hex: '#d8b4fe', titulo: 'Roxo' },
            { hex: '#bbf7d0', titulo: 'Verde' },
            { hex: '#fbcfe8', titulo: 'Rosa' },
            { hex: '#bfdbfe', titulo: 'Fórmulas' }
        ];

        menuFlutuante.innerHTML = `
            <span style="font-size: 11px; color: #a0aec0; margin-right: 4px;">Editar:</span>
            ${paleta.map(p => `
                <button class="ep-cor-btn" data-cor="${p.hex}" title="${p.titulo}"
                    style="background: ${p.hex}; border: ${p.hex === corHexAtual ? '2px solid #fff' : 'none'}; width: 20px; height: 20px; border-radius: 50%; cursor: pointer; padding: 0; box-shadow: ${p.hex === corHexAtual ? '0 0 0 1px #4a5568' : 'none'}; margin-right: 4px;">
                </button>
            `).join('')}
            <div style="width: 1px; height: 16px; background: #4a5568; margin: 0 4px;"></div>
            <button id="ep-btn-editar-nota" style="background: transparent; border: none; cursor: pointer; font-size: 16px; padding: 0 2px;" title="Editar Nota">📝</button>
            <button id="ep-btn-print" style="background: transparent; border: none; cursor: pointer; font-size: 16px; padding: 0 2px;" title="Anexar Print">📸</button>
            <button id="ep-btn-remover" style="background: transparent; border: none; cursor: pointer; font-size: 16px; padding: 0 2px;" title="Remover Grifo">🗑️</button>
        `;
        posicionarMenu(rect);

        menuFlutuante.querySelectorAll('.ep-cor-btn').forEach(btn => {
            btn.onclick = () => {
                const novaCor = btn.getAttribute('data-cor');
                if (novaCor === corHexAtual) { esconderMenu(); return; }

                aplicandoMutacaoInterna = true;
                try {
                    spansGrifo.forEach(s => { s.style.backgroundColor = novaCor; });
                } finally {
                    setTimeout(() => { aplicandoMutacaoInterna = false; }, 0);
                }

