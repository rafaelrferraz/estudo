    // ------------------------------------------------------------------
    // Indexação e Aplicação de Grifos
    // ------------------------------------------------------------------
    function indexarTexto() {
        const nodes = [];
        let T = '';
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
            acceptNode(n) {
                const p = n.parentElement;
                if (!p || p.closest(IGNORAR_UI)) return NodeFilter.FILTER_REJECT;
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let n;
        while ((n = walker.nextNode())) { nodes.push({ node: n, ini: T.length, fim: (T += n.nodeValue).length }); }
        return { nodes, T };
    }

    function textoNormalizadoDoIntervalo(idx, ini, fim) {
        let out = '';
        let primeiro = true, blocoAnterior = null;
        idx.nodes.forEach(e => {
            const s = Math.max(ini, e.ini), f = Math.min(fim, e.fim);
            if (f <= s) return;
            const bloco = e.node.parentElement ? e.node.parentElement.closest(SEL_BLOCO) : null;
            if (!primeiro && bloco !== blocoAnterior) out += ' ';
            out += e.node.nodeValue.slice(s - e.ini, f - e.ini);
            blocoAnterior = bloco; primeiro = false;
        });
        return out.replace(/\s+/g, ' ').trim();
    }

    function envolverTrechoDeTexto(node, start, end, span) {
        let alvo = node;
        if (end < node.nodeValue.length) node.splitText(end);
        if (start > 0) alvo = node.splitText(start);
        alvo.parentNode.insertBefore(span, alvo);
        span.appendChild(alvo);
    }

    function envolverIntervalo(idx, ini, fim, cor, nota, url, idGrifo) {
        const tarefas = [];
        idx.nodes.forEach(e => {
            const s = Math.max(ini, e.ini), f = Math.min(fim, e.fim);
            if (f <= s) return;
            const node = e.node, p = node.parentElement;
            if (!p || p.closest('.estudo-pro-grifo') || p.matches(TAGS_ESTRUTURAIS)) return;
            const trecho = node.nodeValue.slice(s - e.ini, f - e.ini);
            if (!trecho.trim() && !(node.previousSibling && node.nextSibling)) return;
            tarefas.push({ node, ls: s - e.ini, lf: f - e.ini });
        });

        tarefas.forEach(t => {
            const span = document.createElement('span');
            span.className = 'estudo-pro-grifo';
            span.style.backgroundColor = cor || '#fef08a';
            span.style.color = '#1a202c';
            span.setAttribute('data-nota', nota || '');
            span.setAttribute('data-url', url);
            span.setAttribute('data-grifo-id', idGrifo);
            envolverTrechoDeTexto(t.node, t.ls, t.lf, span);
        });
        return tarefas.length;
    }

    function aplicarGrifoEstavel(cor, nota) {
        if (!selecaoAtualGuardada) return;
        const range = selecaoAtualGuardada;
        const url = urlAtual();
        const idx = indexarTexto();
        const T = idx.T;

        let gIni = null, gFim = null;
        idx.nodes.forEach(e => {
            if (!range.intersectsNode(e.node)) return;
            const s = (e.node === range.startContainer) ? range.startOffset : 0;
            const f = (e.node === range.endContainer) ? range.endOffset : e.node.nodeValue.length;
            if (f <= s) return;
            if (gIni === null) gIni = e.ini + s;
            gFim = e.ini + f;
        });

        if (gIni === null || gFim === null || gFim <= gIni) { return; }

        while (gIni < gFim && /\s/.test(T[gIni])) gIni++;
        while (gFim > gIni && /\s/.test(T[gFim - 1])) gFim--;
        if (gFim <= gIni) return;

        let trechoNorm = textoNormalizadoDoIntervalo(idx, gIni, gFim);
        if (!trechoNorm) {
            trechoNorm = T.slice(gIni, gFim).replace(/\s+/g, ' ').trim();
        }
        if (!trechoNorm) {
            try {
                const sel = window.getSelection();
                trechoNorm = (sel && sel.toString() ? sel.toString() : '').replace(/\s+/g, ' ').trim();
            } catch (e) { }
        }
        if (!trechoNorm) return;

        const idGrifo = idDeterministico(url, trechoNorm);
        const pgExistente = lerPagina(url);
        if (pgExistente && pgExistente.grifos.some(g => g.id_grifo === idGrifo && !g.removido_em)) {
            alert("Esse trecho já está grifado nesta página."); return;
        }

        const entrada = {
            id_grifo: idGrifo, criado_em: Date.now(), inicio: gIni, fim: gFim,
            exato: T.slice(gIni, gFim), prefixo: T.slice(Math.max(0, gIni - TAM_CONTEXTO), gIni),
            sufixo: T.slice(gFim, gFim + TAM_CONTEXTO),
            trecho_grifado: trechoNorm,
            cor_fundo: cor, nota_vinculada: nota || null, revisto: false,
            atualizado_em: Date.now()
        };

        aplicandoMutacaoInterna = true;
        try {
            if (envolverIntervalo(idx, gIni, gFim, cor, nota, url, idGrifo) === 0) { return; }
            esconderMenu();
            window.getSelection().removeAllRanges();
            selecaoAtualGuardada = null;
        } finally { setTimeout(() => { aplicandoMutacaoInterna = false; }, 0); }
        adicionarGrifoSalvo(url, entrada);
        agendarSyncAutomatico();
    }

    // 🔧 BLINDAGEM: desembrulha ao ler
    function lerPagina(url) {
        try {
            const raw = stLer(PREFIXO_URL + url);
            if (!raw) return null;
            const p = desembrulhar(raw);
            if (p && Array.isArray(p.grifos)) return p;
        } catch (e) { console.warn('[EstudoPro] JSON inválido em', url, e); }
        return null;
    }

    function salvarPagina(pagina) { stGravar(PREFIXO_URL + pagina.url, JSON.stringify(pagina)); }

    function adicionarGrifoSalvo(url, entrada) {
        if (!entrada || !entrada.trecho_grifado || !String(entrada.trecho_grifado).trim()) return;

        const pagina = lerPagina(url) || { url: url, titulo: '', grifos: [] };
        if (!pagina.titulo) pagina.titulo = (document.title || '').trim() || url;

        const novoGrifo = { ...entrada };
        delete novoGrifo.removido_em;

        const idNovo = novoGrifo.id_grifo;
        if (idNovo) {
            pagina.grifos = pagina.grifos.filter(grifo => grifo.id_grifo !== idNovo);
        }
        pagina.grifos.push(novoGrifo);
        salvarPagina(pagina);
    }

    function atualizarGrifoSalvo(url, idGrifo, campos) {
        const pagina = lerPagina(url);
        if (!pagina) return;
        const entrada = pagina.grifos.find(g => g.id_grifo === idGrifo);
        if (entrada) {
            Object.assign(entrada, campos);
            entrada.atualizado_em = Date.now();
            salvarPagina(pagina);
        }
        agendarSyncAutomatico();
    }

    function removerGrifoSalvo(url, idGrifo) {
        const pagina = lerPagina(url);
        if (!pagina) return;
        const entrada = pagina.grifos.find(g => g.id_grifo === idGrifo);
        if (entrada) {
            entrada.removido_em = Date.now();
            entrada.atualizado_em = Date.now();
            salvarPagina(pagina);
        }
        agendarSyncAutomatico();
    }

    // ------------------------------------------------------------------
    // Saneamento retroativo — 🔧 BLINDADO
    // ------------------------------------------------------------------
    function sanearStorage() {
        let corrigidos = 0;
        stChaves(PREFIXO_URL).forEach(chave => {
            try {
                const raw = stLer(chave);
                if (!raw) return;
                const p = desembrulhar(raw);
                if (!p || !Array.isArray(p.grifos)) return;
                let mudou = false;
                if (!p.titulo || !String(p.titulo).trim()) { p.titulo = p.url || chave.replace(PREFIXO_URL, ''); mudou = true; }
                p.grifos.forEach(g => {
                    if (!g.trecho_grifado && g.exato) { g.trecho_grifado = String(g.exato).replace(/\s+/g, ' ').trim(); mudou = true; }
                    if (!g.trecho_grifado && g.texto) { g.trecho_grifado = String(g.texto).replace(/\s+/g, ' ').trim(); mudou = true; }
                    if (!g.cor_fundo && g.cor) { g.cor_fundo = g.cor; mudou = true; }
                    if (g.nota_vinculada == null && g.nota != null) { g.nota_vinculada = g.nota; mudou = true; }
                });
                if (mudou) { stGravar(chave, JSON.stringify(p)); corrigidos++; }
            } catch (e) { }
        });
        return corrigidos;
    }

