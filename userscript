"</div>",
"",
"<header>",
"    <div class=\"topo-linha\">",
"        <h1>🎯 Painel de Revisão e Retenção</h1>",
"    </div>",
"    <div class=\"controles\">",
"        <input type=\"search\" id=\"busca\" placeholder=\"Buscar texto, anotações ou tags...\">",
"        <select id=\"modo-visao\">",
"            <option value=\"aula\">📚 Por aula</option>",
"            <option value=\"data\">📅 Por data</option>",
"            <option value=\"tag\">🏷️ Por tag</option>",
"        </select>",
"        <div class=\"filtros-cores\" id=\"filtros-cores\"></div>",
"        <button class=\"btn btn-icon\" onclick=\"abrirModalCores()\">⚙️ Nomear Cores</button>",
"    </div>",
"    <div class=\"filtros-tags\" id=\"filtros-tags\"></div>",
"</header>",
"<div class=\"layout\">",
"    <aside class=\"sidebar\">",
"        <div class=\"painel-stats\">",
"            <h3 style=\"margin-top:0; font-size:15px; margin-bottom:10px;\">📊 Desempenho</h3>",
"            <div id=\"stats-resumo\" style=\"font-size:13px; color:var(--mut);\">Carregando...</div>",
"            <div class=\"progresso-bg\"><div class=\"progresso-bar\" id=\"barra-progresso\"></div></div>",
"        </div>",
"        <div class=\"painel-stats\">",
"            <h3 style=\"margin-top:0; font-size:15px; margin-bottom:10px;\">📑 Sumário</h3>",
"            <ul class=\"sumario-lista\" id=\"sumario\"></ul>",
"        </div>",
"    </aside>",
"    <main id=\"lista\"></main>",
"</div>",
"<div class=\"modal-overlay\" id=\"modal-cores\">",
"    <div class=\"modal-box\">",
"        <div style=\"font-weight:bold;font-size:16px;\">⚙️ Organizar Cores da Revisão</div>",
"        <div id=\"modal-cores-lista\"></div>",
"        <div style=\"display:flex;justify-content:flex-end;gap:10px;margin-top:10px;\">",
"            <button class=\"btn\" onclick=\"fecharModalCores()\">Cancelar</button>",
"            <button class=\"btn btn-destaque\" onclick=\"salvarCores()\">Salvar</button>",
"        </div>",
"    </div>",
"</div>",
"<scr"+"ipt id=\"dados\" type=\"application/json\">__DADOS__</scr"+"ipt>",
"<scr"+"ipt>",
"const escapeHtml = (str) => {",
"    if(str === undefined || str === null) return '';",
"    const div = document.createElement('div'); div.textContent = String(str); return div.innerHTML;",
"};",
"const CHAVE_DB = 'revisao_db_v1';",
"let db;",
"try {",
"    const raw = document.getElementById('dados').textContent.trim();",
"    if (!raw || raw === '__DADOS__') throw new Error('placeholder nao substituido');",
"    db = JSON.parse(raw);",
"    console.log('[Revisao] JSON ok:', (db.grupos||[]).length, 'grupos');",
"} catch (e) {",
"    console.error('[Revisao] JSON invalido:', e);",
"    db = { config: { cores: {} }, grupos: [] };",
"}",
"if (!Array.isArray(db.grupos)) db.grupos = [];",
"if (!db.config) db.config = { cores: {} };",
"if (!db.config.cores) db.config.cores = {};",
"function persistir() {",
"    try { localStorage.setItem(CHAVE_DB, JSON.stringify(db)); } catch (e) { }",
"}",
"let filtroCor = null;",
"let filtroTag = null;",
"const SEM_TAG = '__sem__';",
"function normTag(s) {",
"    let out = '';",
"    s = String(s || '').toLowerCase();",
"    for (const c of s) {",
"        if (c.toLowerCase() !== c.toUpperCase() || (c >= '0' && c <= '9') || c === ' ' || c === '-' || c === '_' || c === '/' || c === '.') out += c;",
"    }",
"    return out.split(' ').filter(Boolean).join(' ');",
"}",
"function unicos(arr) { return Array.from(new Set(arr)); }",
"function parseTags(str) { return unicos(String(str || '').split(';').join(',').split(',').map(normTag).filter(Boolean)); }",
"function hashSimples(s) {",
"    let h = 0;",
"    for (let i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) | 0; }",
"    return Math.abs(h).toString(36);",
"}",
"(function prepararDados() {",
"    const vistos = new Set();",
"    db.grupos.forEach(gr => {",
"        if (!Array.isArray(gr.grifos)) gr.grifos = [];",
"        gr.grifos.forEach(g => {",
"            let id = String(g.id || '');",
"            if (!id || !/[\\w-]+/.test(id) || vistos.has(id)) {",
"                let base = 'h' + hashSimples((g.texto || '') + '|' + (g.criado || ''));",
"                let candidato = base;",
"                let k = 0;",
"                while (vistos.has(candidato)) { candidato = base + '_' + (k++); }",
"                id = candidato;",
"            }",
"            g.id = id;",
"            vistos.add(id);",
"            g.tags = Array.isArray(g.tags) ? parseTags(g.tags.join(',')) : [];",
"        });",
"    });",
"})();",
"function acharPorId(id) {",
"    for (const gr of db.grupos) for (const g of gr.grifos) if (g.id === id) return g;",
"    return null;",
"}",
"function todasTags() {",
"    const mapa = {};",
"    db.grupos.forEach(gr => gr.grifos.forEach(g => g.tags.forEach(t => { mapa[t] = (mapa[t] || 0) + 1; })));",
"    return Object.keys(mapa).sort((a, b) => a.localeCompare(b, 'pt-BR')).map(t => [t, mapa[t]]);",
"}",
"function chaveData(ts) {",
"    if (!ts) return 'sem-data';",
"    const d = new Date(ts);",
"    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
"}",
"function rotuloData(chave) {",
"    if (chave === 'sem-data') return '📂 Sem data (legado)';",
"    const p = chave.split('-');",
"    return '📅 ' + p[2] + '/' + p[1] + '/' + p[0];",
"}",
"function secoesDaVisao() {",
"    const modo = document.getElementById('modo-visao').value;",
"    if (modo === 'aula') {",
"        return db.grupos.map((gr, gIdx) => ({",
"            titulo: gr.titulo, url: gr.url, mostrarAula: false, isGroup: true, gIdxOrig: gIdx,",
"            itens: gr.grifos.map((g, iIdx) => ({ g, gIdx, iIdx }))",
"        }));",
"    }",
"    if (modo === 'tag') {",
"        const mapaTag = {};",
"        db.grupos.forEach((gr, gIdx) => gr.grifos.forEach((g, iIdx) => {",
"            const ts = g.tags.length ? g.tags : [SEM_TAG];",
"            ts.forEach(t => { (mapaTag[t] = mapaTag[t] || []).push({ g, gIdx, iIdx }); });",
"        }));",
"        return Object.keys(mapaTag).sort((a, b) => a === SEM_TAG ? 1 : b === SEM_TAG ? -1 : a.localeCompare(b, 'pt-BR'))",
"            .map(k => ({ titulo: k === SEM_TAG ? '🏷️ Sem tag' : '🏷️ #' + k, url: '', mostrarAula: true, itens: mapaTag[k] }));",
"    }",
"    const mapa = {};",
"    db.grupos.forEach((gr, gIdx) => gr.grifos.forEach((g, iIdx) => {",
"        const k = chaveData(g.criado);",
"        (mapa[k] = mapa[k] || []).push({ g, gIdx, iIdx });",
"    }));",
"    return Object.keys(mapa).sort((a, b) => a === 'sem-data' ? 1 : b === 'sem-data' ? -1 : b.localeCompare(a))",
"        .map(k => ({ titulo: rotuloData(k), url: '', mostrarAula: true, itens: mapa[k] }));",
"}",
"function htmlTagsGrifo(g) {",
"    if (!g.tags.length) return '';",
"    return '<div class=\"g-tags\">' + g.tags.map(t => '<span class=\"tag\">#' + escapeHtml(t) + ' <b data-id=\"' + escapeHtml(g.id) + '\" data-tag=\"' + escapeHtml(t) + '\" onclick=\"removerTagEl(this)\">×</b></span>').join('') + '</div>';",
"}",
"function render() {",
"    const lista = document.getElementById('lista');",
"    const sumario = document.getElementById('sumario');",
"    const termoBusca = document.getElementById('busca').value.toLowerCase();",
"    if (filtroTag && filtroTag !== SEM_TAG && !todasTags().some(([t]) => t === filtroTag)) filtroTag = null;",
"    let html = '';",
"    let sumarioHtml = '';",
"    let total = 0, revistos = 0, comNota = 0;",
"    const vistosTotais = new Set();",
"    const secoes = secoesDaVisao();",
"    secoes.forEach(gr => {",
"        let countSecao = 0;",
"        gr.itens.forEach(({ g }) => {",
"            if (!vistosTotais.has(g.id)) {",
"                vistosTotais.add(g.id); total++;",
"                if (g.revisto) revistos++;",
"                if (g.nota) comNota++;",
"            }",
"            countSecao++;",
"        });",
"        gr._totalReal = countSecao;",
"    });",
"    secoes.forEach((gr, sIdx) => {",
"        let grifosHtml = '';",
"        let idSecao = 'aula-' + sIdx;",
"        gr.itens.forEach(({ g, gIdx, iIdx }) => {",
"            const corHex = g.cor || '#fef08a';",
"            let pular = false;",
"            if (filtroCor && corHex !== filtroCor) pular = true;",
"            if (filtroTag) {",
"                if (filtroTag === SEM_TAG) { if (g.tags.length) pular = true; }",
"                else if (!g.tags.includes(filtroTag)) pular = true;",
"            }",
"            const txt = (String(g.texto || '') + ' ' + String(g.nota || '') + ' ' + g.tags.join(' ')).toLowerCase();",
"            if (termoBusca && !txt.includes(termoBusca)) pular = true;",
"            if (pular) return;",
"            const chave = sIdx + '-' + gIdx + '-' + iIdx;",
"            grifosHtml += `<div class=\"g\" data-id=\"${g.id}\" style=\"border-left-color: ${corHex}; opacity: ${g.revisto ? '0.85' : '1'};\">",
"                <div id=\"view-${chave}\">",
"                    ${gr.mostrarAula ? `<div style=\"font-size:11px;color:var(--mut);margin-bottom:6px;\">📚 ${escapeHtml(db.grupos[gIdx].titulo)}</div>` : ''}",
"                    <div class=\"g-texto\"><mark style=\"background:${corHex};\" onclick=\"abrirMenuGrifo(event, '${g.id}')\">${escapeHtml(g.texto)}</mark></div>",
"                    ${g.nota ? `<div class=\"g-nota\"><strong>📌 Anotação:</strong><br>${g.nota}</div>` : ''}",
"                    ${htmlTagsGrifo(g)}",
"                    <div class=\"g-footer\"><label style=\"cursor:pointer; display:flex; align-items:center; gap:6px; font-weight:600; color:${g.revisto ? 'var(--ok)' : 'var(--txt)'}\">",
"                        <input type=\"checkbox\" ${g.revisto ? 'checked' : ''} onchange=\"toggleRevisto(${gIdx}, ${iIdx})\"> ${g.revisto ? '✓ Revisado' : 'Marcar Revisado'}</label></div>",
"                </div>",
"            </div>`;",
"        });",
"        if (gr._totalReal > 0) {",
"            const tituloExibicao = escapeHtml(gr.titulo || 'Página sem título');",
"            sumarioHtml += `<li><a href=\"#${idSecao}\" onclick=\"event.preventDefault(); scrollToSecao('${idSecao}')\">${tituloExibicao} (${gr._totalReal})</a></li>`;",
"            if (grifosHtml.trim() !== '') {",
"                html += `<article class=\"q\" id=\"${idSecao}\"><div class=\"q-head\"><div class=\"q-titulo\">",
"                    ${gr.isGroup ? `<span onclick=\"renomearGrupo(${gr.gIdxOrig})\" title=\"Clique para renomear\">${tituloExibicao}</span>` : `<span>${tituloExibicao}</span>`}",
"                    </div>${gr.url ? `<a href=\"${escapeHtml(gr.url)}\" target=\"_blank\" class=\"q-link\">Fonte ↗</a>` : ''}</div>",
"                    <div class=\"q-body\">${grifosHtml}</div></article>`;",
"            }",
"        }",
"    });",
"    lista.innerHTML = html || '<div style=\"text-align:center; padding: 40px; color: var(--mut); font-size:16px;\">Nenhum grifo corresponde aos filtros selecionados.</div>';",
"    sumario.innerHTML = sumarioHtml;",
"    const pct = total > 0 ? Math.round((revistos/total)*100) : 0;",
"    document.getElementById('stats-resumo').innerHTML = `Grifos: <b>${total}</b> <br>Notas: <b>${comNota}</b> <br>Feito: <b>${pct}%</b>`;",
"    document.getElementById('barra-progresso').style.width = pct + '%';",
"    renderFiltros();",
"    renderFiltrosTags();",
"    persistir();",
"}",
"window.renomearGrupo = (gIdx) => {",
"    const atual = db.grupos[gIdx].titulo;",
"    const novo = prompt('Novo nome para a aula/matéria:', atual);",
"    if (novo && novo.trim() !== '') { db.grupos[gIdx].titulo = novo.trim(); render(); }",
"};",
"window.scrollToSecao = (idSecao) => {",
"    filtroCor = null;",
"    filtroTag = null;",
"    document.getElementById('busca').value = '';",
"    render();",
"    const alvo = document.getElementById(idSecao);",
"    if (alvo) {",
"        const topoHeader = document.querySelector('header').offsetHeight + 20;",
"        const y = alvo.getBoundingClientRect().top + window.scrollY - topoHeader;",
"        window.scrollTo({ top: y, behavior: 'smooth' });",
"    }",
"};",
"window.abrirMenuGrifo = (ev, id) => {",
"    ev.preventDefault();",
"    ev.stopPropagation();",
"    const g = acharPorId(id);",
"    if (!g) return;",
"    const menu = document.getElementById('ep-menu-interativo');",
"    menu.style.display = 'flex';",
"    menu.style.top = (ev.pageY - 40) + 'px';",
"    menu.style.left = (ev.pageX - 100) + 'px';",
"    menu.innerHTML = `",
"        <div style=\"font-size:11px; color:#a0aec0; width:100%; margin-bottom:5px; text-align:center;\">Gerenciar</div>",
"        <div style=\"display:flex; gap:6px; margin-bottom:8px; justify-content:center;\">",
"            ${Object.entries(db.config.cores).map(([hex, nome]) => `",
"                <div style=\"background:${hex}; width:18px; height:18px; border-radius:50%; cursor:pointer; border:2px solid ${hex === g.cor ? '#fff' : 'transparent'}\" onclick=\"mudarCorGrifo('${id}', '${hex}')\" title=\"${escapeHtml(nome)}\"></div>",
"            `).join('')}",
"        </div>",
"        <div style=\"display:flex; gap:6px; justify-content:center;\">",
"            <button class=\"btn btn-icon\" onclick=\"editarNotaGrifo('${id}')\" title=\"Editar Nota\" style=\"font-size:16px; padding:4px 8px; border:1px solid var(--borda); background:var(--card2);\">📝</button>",
"            <button class=\"btn btn-icon\" onclick=\"addTagGrifo('${id}')\" title=\"Adicionar Tag\" style=\"font-size:16px; padding:4px 8px; border:1px solid var(--borda); background:var(--card2);\">🏷️</button>",
"            <button class=\"btn btn-icon\" onclick=\"removerGrifoPorId('${id}')\" title=\"Excluir\" style=\"font-size:16px; padding:4px 8px; border:1px solid var(--borda); background:#e53e3e; color:#fff;\">🗑️</button>",
"        </div>`;",
"    const fechaMenu = (e) => {",
"        if (!menu.contains(e.target)) { menu.style.display = 'none'; document.removeEventListener('click', fechaMenu); }",
"    };",
