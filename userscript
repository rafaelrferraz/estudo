// ==UserScript==
// @name         Estudo Pró - Caderno de Alta Performance (Concurseiro) oficial
// @namespace    http://tampermonkey.net/
// @version      35.1
// @match        https://concursos.estrategia.com/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_listValues
// @grant        GM_xmlhttpRequest
// @connect      estudos-sync.rrferraz-server.com.br
// ==/UserScript==

(function() {
    'use strict';

    let menuFlutuante = null;
    let modalNota = null;
    let selecaoAtualGuardada = null;
    let ultimaUrl = location.href;

    let aplicandoMutacaoInterna = false;
    let timerRestauracao = null;
    let timerSync = null;
    let sincronizacaoInicialFeita = false;

    // ==================================================================
    // 🔧 BLINDAGEM — desembrulhar dupla serialização
    // ==================================================================
    function desembrulhar(v) {
        let x = v, n = 0;
        while (typeof x === 'string' && n < 5) {
            try { x = JSON.parse(x); } catch (e) { break; }
            n++;
        }
        return x;
    }

    // ------------------------------------------------------------------
    // Armazenamento
    // ------------------------------------------------------------------
    const TEM_GM = typeof GM_getValue === 'function' && typeof GM_setValue === 'function'
                && typeof GM_deleteValue === 'function' && typeof GM_listValues === 'function';

    function stLer(chave) {
        if (TEM_GM) {
            try {
                const v = GM_getValue(chave, null);
                if (v !== null && v !== undefined) return v;
            } catch (e) { }
        }
        try { return localStorage.getItem(chave); } catch (e) { return null; }
    }

    function stGravar(chave, valor) {
        let ok = false;
        if (TEM_GM) {
            try { GM_setValue(chave, valor); ok = true; }
            catch (e) { console.warn('[EstudoPro] GM_setValue falhou', e); }
        }
        try { localStorage.setItem(chave, valor); ok = true; } catch (e) { }
        return ok;
    }

    function stApagar(chave) {
        if (TEM_GM) { try { GM_deleteValue(chave); } catch (e) { } }
        try { localStorage.removeItem(chave); } catch (e) { }
    }

    function stChaves(prefixo) {
        const conjunto = new Set();
        if (TEM_GM) {
            try {
                GM_listValues().forEach(k => {
                    if (k && k.startsWith(prefixo)) conjunto.add(k);
                });
            } catch (e) { }
        }
        try {
            for (let i = 0; i < localStorage.length; i++) {
                const k = localStorage.key(i);
                if (k && k.startsWith(prefixo)) conjunto.add(k);
            }
        } catch (e) { }
        return Array.from(conjunto);
    }

    const PREFIXO_URL = 'estudo_pro_u_';
    const PREFIXO_LEGADO = 'estudo_pro_q_';
    const IGNORAR_UI = 'script, style, noscript, template, textarea, svg, button, #ep-menu-flutuante, #ep-modal-overlay, #ep-fab-container';
    const TAGS_ESTRUTURAIS = 'table, thead, tbody, tfoot, tr, colgroup, ul, ol, select, dl';
    const SEL_BLOCO = 'p, div, li, tr, td, th, h1, h2, h3, h4, h5, h6, blockquote, section, article';
    const TAM_CONTEXTO = 30;

    const estilo = document.createElement('style');
    estilo.innerHTML = `
        .estudo-pro-grifo { cursor: pointer; border-radius: 2px; transition: filter 0.2s; }
        .estudo-pro-grifo:hover { filter: brightness(0.9); }
        #ep-fab-container { position: fixed; bottom: 25px; right: 25px; z-index: 99998; font-family: sans-serif; display: flex; flex-direction: column-reverse; align-items: center; gap: 10px; }
        #ep-fab-btn { background: #2d3748; color: #fff; width: 52px; height: 52px; border-radius: 50%; border: 2px solid #4a5568; box-shadow: 0 4px 15px rgba(0,0,0,0.5); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.2s, background 0.2s; }
        #ep-fab-btn:hover { transform: scale(1.1); background: #4a5568; }
        #ep-fab-btn svg { width: 24px; height: 24px; fill: currentColor; }
        #ep-fab-sub-menu { display: flex; flex-direction: column; gap: 8px; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s; }
        #ep-fab-container:hover #ep-fab-sub-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .ep-sub-btn { background: #1a202c; color: #fff; width: 42px; height: 42px; border-radius: 50%; border: 1px solid #4a5568; box-shadow: 0 4px 10px rgba(0,0,0,0.4); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; transition: transform 0.2s, background 0.2s; }
        .ep-sub-btn:hover { transform: scale(1.12); background: #4a5568; }
        .ep-sub-btn.btn-html { color: #9ae6b4; }
        .ep-sub-btn.btn-sync { color: #63b3ed; font-size: 16px; }
        .ep-sub-btn.btn-trash { color: #fc8181; font-size: 16px; }
        .ep-sub-btn.btn-trash:hover { background: #e53e3e; color: #fff; }
        #ep-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: 100000; display: none; align-items: center; justify-content: center; font-family: sans-serif; }
        #ep-modal-box { background: #1a202c; color: #fff; width: 420px; padding: 20px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border: 1px solid #4a5568; display: flex; flex-direction: column; gap: 12px; }
        #ep-modal-box textarea { width: 100%; height: 120px; background: #2d3748; color: #fff; border: 1px solid #4a5568; border-radius: 6px; padding: 10px; font-size: 13px; resize: vertical; outline: none; box-sizing: border-box; }
        #ep-modal-box textarea:focus { border-color: #805ad5; }
        .ep-modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
        .ep-modal-actions button { padding: 6px 14px; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 12px; border: none; }
        #ep-modal-salvar { background: #805ad5; color: #fff; }
        #ep-modal-cancelar { background: #4a5568; color: #fff; }
    `;
    document.head.appendChild(estilo);

    if (document.readyState === 'complete') {
        setTimeout(iniciarSistemaGlobal, 0);
    } else {
        window.addEventListener('load', iniciarSistemaGlobal);
    }

    setInterval(() => {
        if (location.href !== ultimaUrl) {
            ultimaUrl = location.href;
            sincronizacaoInicialFeita = false;
            setTimeout(iniciarSistemaGlobal, 1000);
        }
    }, 500);

    setInterval(() => {
        enviarParaServidorSilencioso();
    }, 3600000);

    function agendarRestauracao() {
        if (timerRestauracao) clearTimeout(timerRestauracao);
        timerRestauracao = setTimeout(() => { restaurarGrifosSalvos(); }, 600);
    }

    const observer = new MutationObserver((mutations) => {
        if (aplicandoMutacaoInterna) return;
        let deveAtualizar = false;
        for (let m of mutations) {
            if (m.target && m.target.closest && m.target.closest('#ep-menu-flutuante, #ep-modal-overlay, #ep-fab-container')) continue;
            if (m.type === 'childList' && m.addedNodes.length > 0) { deveAtualizar = true; break; }
            if (m.type === 'characterData') { deveAtualizar = true; break; }
        }
        if (deveAtualizar) agendarRestauracao();
    });

    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
    window.addEventListener('focus', agendarRestauracao);

    function iniciarSistemaGlobal() {
        criarMenuSelecao();
        criarModalNota();
        criarBotaoHover();
        agendarRestauracao();

        if (!sincronizacaoInicialFeita) {
            puxarDoServidorNaInicializacao();
            sincronizacaoInicialFeita = true;
        }
    }

    // ------------------------------------------------------------------
    // Utilitários UI e Hash
    // ------------------------------------------------------------------
    function gerarId() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }
    function escaparHtml(str) { const d = document.createElement('div'); d.textContent = str == null ? '' : String(str); return d.innerHTML; }
    function escaparAttr(str) { return String(str).replace(/["\\]/g, '\\$&'); }
    function tamSufixoComum(a, b) { let i = 0; while (i < a.length && i < b.length && a[a.length - 1 - i] === b[b.length - 1 - i]) i++; return i; }
    function tamPrefixoComum(a, b) { let i = 0; while (i < a.length && i < b.length && a[i] === b[i]) i++; return i; }

    function urlAtual() {
        let path = location.pathname;
        if (path.endsWith('/') && location.search) {
            path = path.slice(0, -1);
        }
        return location.origin + path + location.search;
    }

    function hashSimples(s) {
        let h = 0;
        for (let i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) | 0; }
        return Math.abs(h).toString(36);
    }

    function hash53(s) {
        let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
        for (let i = 0; i < s.length; i++) {
            const ch = s.charCodeAt(i);
            h1 = Math.imul(h1 ^ ch, 2654435761);
            h2 = Math.imul(h2 ^ ch, 1597334677);
        }
        h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
        h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
        return 4294967296 * (2097151 & h2) + (h1 >>> 0);
    }
    function idDeterministico(url, trecho) { return 'g' + hash53(url + '|' + trecho).toString(36); }

    // ------------------------------------------------------------------
    // Menu e UI
    // ------------------------------------------------------------------
    function criarMenuSelecao() {
        if (menuFlutuante) return;
        menuFlutuante = document.createElement('div');
        menuFlutuante.id = 'ep-menu-flutuante';
        menuFlutuante.style.cssText = `position: absolute; background: #2d3748; color: #fff; padding: 8px 12px; border-radius: 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.4); z-index: 99999; display: none; font-family: sans-serif; font-size: 13px; align-items: center; gap: 8px;`;
        menuFlutuante.addEventListener('mousedown', (e) => e.preventDefault());
        document.body.appendChild(menuFlutuante);
    }

    function criarModalNota() {
        if (document.getElementById('ep-modal-overlay')) return;
        modalNota = document.createElement('div');
        modalNota.id = 'ep-modal-overlay';
        modalNota.innerHTML = `
            <div id="ep-modal-box">
                <div style="font-weight: bold; font-size: 14px; border-bottom: 1px solid #4a5568; padding-bottom: 6px;">📝 Anotação Profissional</div>
                <textarea id="ep-modal-textarea" placeholder="Digite sua anotação, esquema ou mnemônico aqui..."></textarea>
                <div class="ep-modal-actions">
                    <button id="ep-modal-cancelar">Cancelar</button>
                    <button id="ep-modal-salvar">Salvar Nota</button>
                </div>
            </div>
        `;
        document.body.appendChild(modalNota);
        document.getElementById('ep-modal-cancelar').onclick = () => { modalNota.style.display = 'none'; selecaoAtualGuardada = null; };
    }

    function abrirModalNota(callbackSalvar, textoInicial) {
        const textarea = document.getElementById('ep-modal-textarea');
        textarea.value = textoInicial || "";
        modalNota.style.display = 'flex';
        textarea.focus();

        const btnSalvar = document.getElementById('ep-modal-salvar');
        const novoBtnSalvar = btnSalvar.cloneNode(true);
        btnSalvar.parentNode.replaceChild(novoBtnSalvar, btnSalvar);
        document.getElementById('ep-modal-salvar').onclick = () => {
            modalNota.style.display = 'none';
            callbackSalvar(textarea.value.trim());
        };
    }

    function criarBotaoHover() {
        if (document.getElementById('ep-fab-container')) return;
        const container = document.createElement('div');
        container.id = 'ep-fab-container';
        container.innerHTML = `
            <button id="ep-fab-btn">
                <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            </button>
            <div id="ep-fab-sub-menu">
                <button id="ep-sub-trash" class="ep-sub-btn btn-trash" title="Apagar TODOS os dados do site (localStorage + Tampermonkey)">🗑️</button>
                <button id="ep-sub-sync" class="ep-sub-btn btn-sync" title="Forçar Sincronização">☁️</button>
                <button id="ep-sub-html" class="ep-sub-btn btn-html" title="Baixar HTML Manual">HTML</button>
            </div>
        `;
        document.body.appendChild(container);

        document.getElementById('ep-sub-html').onclick = (e) => { e.stopPropagation(); exportarHtmlInterativo(); };
        document.getElementById('ep-sub-sync').onclick = (e) => { e.stopPropagation(); enviarParaServidorSilencioso(); alert("Sincronização forçada enviada!"); };
        document.getElementById('ep-sub-trash').onclick = (e) => { e.stopPropagation(); apagarTodosOsDados(); };
    }

    // ------------------------------------------------------------------
    // 🗑️ Apagar todos os dados (localStorage + GM) — com confirmação
    // ------------------------------------------------------------------
    function apagarTodosOsDados() {
        const chavesUrl = stChaves(PREFIXO_URL);
        const chavesLegado = stChaves(PREFIXO_LEGADO);
        const totalChaves = chavesUrl.length + chavesLegado.length;

        if (totalChaves === 0) {
            alert("Nenhum dado encontrado para apagar neste site.");
            return;
        }

        const confirmacao1 = confirm(
            `⚠️ ATENÇÃO — APAGAR TUDO DO SITE\n\n` +
            `Serão removidos:\n` +
            `• ${chavesUrl.length} página(s) com grifos (formato novo)\n` +
            `• ${chavesLegado.length} bloco(s) legado(s)\n` +
            `• Cópias no localStorage E no armazenamento do Tampermonkey\n\n` +
            `Isso NÃO apaga o servidor remoto, mas a próxima sincronização\n` +
            `pode acabar regravando os dados puxados de lá.\n\n` +
            `Continuar?`
        );
        if (!confirmacao1) return;

        const confirmacao2 = prompt(
            `Para confirmar a exclusão, digite exatamente:\n\nAPAGAR`
        );
        if (confirmacao2 !== 'APAGAR') {
            alert("Operação cancelada. Nada foi apagado.");
            return;
        }

        let apagadas = 0;
        [...chavesUrl, ...chavesLegado].forEach(chave => {
            try { stApagar(chave); apagadas++; } catch (e) { console.warn('[EstudoPro] Falha ao apagar', chave, e); }
        });

        // Remove qualquer chave solta do localStorage que comece com os prefixos
        // (garante limpeza mesmo se GM_listValues não pegou algo)
        try {
            const remover = [];
            for (let i = 0; i < localStorage.length; i++) {
                const k = localStorage.key(i);
                if (k && (k.startsWith(PREFIXO_URL) || k.startsWith(PREFIXO_LEGADO))) remover.push(k);
            }
            remover.forEach(k => localStorage.removeItem(k));
        } catch (e) { }

        // Cancela timers pendentes para não regravar nada em seguida
        if (timerSync) { clearTimeout(timerSync); timerSync = null; }
        if (timerRestauracao) { clearTimeout(timerRestauracao); timerRestauracao = null; }

        alert(
            `🗑️ Dados apagados!\n\n` +
            `Chaves processadas: ${apagadas}\n\n` +
            `A página será recarregada para limpar a interface.\n` +
            `(Se a sincronização automática puxar dados do servidor, eles voltarão.)`
        );

        setTimeout(() => location.reload(), 300);
    }

    // ------------------------------------------------------------------
    // Sincronização (Envio e Pull) — 🔧 BLINDADO
    // ------------------------------------------------------------------
    function agendarSyncAutomatico() {
        if (timerSync) clearTimeout(timerSync);
        timerSync = setTimeout(() => {
            enviarParaServidorSilencioso();
        }, 5000);
    }

    // 🔧 BLINDAGEM: desembrulha antes de enviar, envia com 1 stringify só
    function enviarParaServidorSilencioso() {
        const pacote = {};
        stChaves(PREFIXO_URL).forEach(c => {
            const v = stLer(c);
            if (!v) return;
            const limpo = desembrulhar(v);
            if (limpo && limpo.grifos) pacote[c] = JSON.stringify(limpo);
        });
        stChaves(PREFIXO_LEGADO).forEach(c => {
            const v = stLer(c);
            if (!v) return;
            const limpo = desembrulhar(v);
            if (limpo) pacote[c] = JSON.stringify(limpo);
        });

        if (Object.keys(pacote).length === 0) return;

        GM_xmlhttpRequest({
            method: "POST",
            url: "https://estudos-sync.rrferraz-server.com.br/api/sync",
            headers: { "Content-Type": "application/json" },
            data: JSON.stringify(pacote),
            onload: function(r) {
                if (r.status >= 200 && r.status < 300) {
                    console.log('☁️ Sincronizado (limpo).');
                } else {
                    console.warn('☁️ Falha na sincronização:', r.status);
                }
            },
            onerror: function(e) { console.error('☁️ Erro de rede na sincronização:', e); }
        });
    }

    // 🔧 BLINDAGEM: desembrulha o remoto antes de gravar
    function puxarDoServidorNaInicializacao() {
        GM_xmlhttpRequest({
            method: "GET",
            url: "https://estudos-sync.rrferraz-server.com.br/api/sync",
            onload: function(r) {
                if (r.status !== 200) return;
                try {
                    const pacoteRemoto = JSON.parse(r.responseText);
                    if (!pacoteRemoto || Object.keys(pacoteRemoto).length === 0) return;

                    let atualizou = false;

                    Object.keys(pacoteRemoto).forEach(chave => {
                        if (!chave.startsWith(PREFIXO_URL)) return;
                        const remoto = desembrulhar(pacoteRemoto[chave]);
                        if (!remoto || !Array.isArray(remoto.grifos)) return;
                        const jsonRemoto = JSON.stringify(remoto);
                        const local = desembrulhar(stLer(chave));
                        const jsonLocal = local ? JSON.stringify(local) : '';
                        if (jsonLocal !== jsonRemoto) {
                            stGravar(chave, jsonRemoto);
                            atualizou = true;
                        }
                    });

                    stChaves(PREFIXO_URL).forEach(chave => {
                        if (!pacoteRemoto[chave]) {
                            stApagar(chave);
                            atualizou = true;
                        }
                    });

                    if (atualizou) {
                        location.reload();
                    }
                } catch (e) { console.error('Erro ao puxar sync:', e); }
            }
        });
    }

    // ------------------------------------------------------------------
    // Lógica de Grifos
    // ------------------------------------------------------------------
