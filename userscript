    function localizarTrecho(T, item) {
        const ex = item.exato || item.trecho_grifado;
        if (!ex) return null;

        const pre = item.prefixo || '', suf = item.sufixo || '';
        const len = ex.length;

        if (item.inicio != null && T.substr(item.inicio, len) === ex) {
            if (T.slice(Math.max(0, item.inicio - pre.length), item.inicio) === pre && T.substr(item.inicio + len, suf.length) === suf) return item.inicio;
        }

        let melhor = null, melhorTotal = -Infinity, melhorScore = 0, ocorrencias = 0, pos = -1;
        while ((pos = T.indexOf(ex, pos + 1)) !== -1) {
            ocorrencias++;
            const score = tamSufixoComum(T.slice(Math.max(0, pos - pre.length), pos), pre) + tamPrefixoComum(T.substr(pos + len, suf.length), suf);
            const dist = item.inicio != null ? Math.abs(pos - item.inicio) : 0;
            const total = score * 1e6 - dist;
            if (total > melhorTotal) { melhorTotal = total; melhor = pos; melhorScore = score; }
        }

        if (melhor === null) return null;
        if (ocorrencias === 1) return melhor;

        const minimo = Math.min(12, pre.length + suf.length);
        if (minimo > 0 && melhorScore >= minimo) return melhor;
        if (len >= 60) return melhor;

        return null;
    }

    function restaurarGrifosSalvos() {
        const itens = [];
        const semBarra = s => s.replace(/\/+$/, '');
        const rota = semBarra(location.origin + location.pathname);
        stChaves(PREFIXO_URL).forEach(chave => {
            const u = chave.slice(PREFIXO_URL.length), i = u.indexOf('?');
            if (semBarra(i >= 0 ? u.slice(0, i) : u) === rota) {
                const p = lerPagina(u);
                if (p) p.grifos.forEach(g => itens.push({ g, url: p.url }));
            }
        });

        const pendentes = itens.filter(({ g }) =>
            !g.removido_em &&
            !document.querySelector(`.estudo-pro-grifo[data-grifo-id="${escaparAttr(g.id_grifo)}"]`)
        );

        if (pendentes.length === 0) return;

        pendentes.sort((a, b) => (a.g.criado_em || 0) - (b.g.criado_em || 0));

        aplicandoMutacaoInterna = true;
        try {
            let idx = indexarTexto();
            pendentes.forEach(({ g, url }) => {
                const pos = localizarTrecho(idx.T, g);
                if (pos !== null) {
                    const ex = g.exato || g.trecho_grifado;
                    if (envolverIntervalo(idx, pos, pos + ex.length, g.cor_fundo, g.nota_vinculada || '', url, g.id_grifo) > 0) {
                        idx = indexarTexto();
                    }
                }
            });
        } finally { setTimeout(() => { aplicandoMutacaoInterna = false; }, 0); }
    }

